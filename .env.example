# copy to .env (never commit .env)
AGENT_RO_PASSWORD=change-me      # FalkorDB read-only user for agents and our MCP server
MCP_RO_PASSWORD=change-me        # FalkorDB read-only user for the sponsor MCP server (ntsb graph only)
WS_WRITER_PASSWORD=change-me     # FalkorDB user that may write ws_* workspace graphs only
MCP_API_KEY=change-me            # bearer token for the FalkorDB MCP server (http :8080)
LLM_PROVIDER=stub                # stub (offline, deterministic) or openrouter
LLM_MODEL=
OPENROUTER_API_KEY=
